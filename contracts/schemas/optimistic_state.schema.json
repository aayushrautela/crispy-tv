{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "optimistic_state fixture",
  "type": "object",
  "required": [
    "contract_version",
    "suite",
    "case_id",
    "operation",
    "input",
    "expected"
  ],
  "properties": {
    "contract_version": {
      "type": "integer",
      "minimum": 1
    },
    "suite": {
      "const": "optimistic_state"
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "operation": {
      "type": "string",
      "enum": [
        "derive",
        "plan_outbox"
      ]
    },
    "input": {
      "type": "object",
      "required": [
        "snapshot",
        "mutations"
      ],
      "properties": {
        "snapshot": {
          "$ref": "#/$defs/snapshot"
        },
        "mutations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mutation"
          }
        },
        "now_ms": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "expected": {
      "type": "object",
      "oneOf": [
        {
          "required": [
            "watchlist",
            "title_watched",
            "rating",
            "episode_watched",
            "season_watched"
          ],
          "properties": {
            "watchlist": {
              "$ref": "#/$defs/derived_field_bool"
            },
            "title_watched": {
              "$ref": "#/$defs/derived_field_bool"
            },
            "rating": {
              "$ref": "#/$defs/derived_field_rating"
            },
            "episode_watched": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/derived_field_bool"
              }
            },
            "season_watched": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/derived_field_bool"
              }
            }
          },
          "additionalProperties": false
        },
        {
          "required": [
            "actions"
          ],
          "properties": {
            "actions": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "mutation_id",
                  "kind"
                ],
                "properties": {
                  "mutation_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "watchlist",
                      "title_watched",
                      "episode_watched",
                      "season_watched",
                      "rating"
                    ]
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "additionalProperties": false,
  "$defs": {
    "snapshot": {
      "type": "object",
      "required": [
        "is_in_watchlist",
        "is_watched",
        "is_rated",
        "user_rating",
        "episode_watched",
        "season_watched"
      ],
      "properties": {
        "is_in_watchlist": {
          "type": "boolean"
        },
        "is_watched": {
          "type": "boolean"
        },
        "is_rated": {
          "type": "boolean"
        },
        "user_rating": {
          "type": [
            "integer",
            "null"
          ]
        },
        "episode_watched": {
          "type": "object",
          "additionalProperties": {
            "type": "boolean"
          }
        },
        "season_watched": {
          "type": "object",
          "additionalProperties": {
            "type": "boolean"
          }
        }
      },
      "additionalProperties": false
    },
    "mutation": {
      "type": "object",
      "required": [
        "kind",
        "id",
        "entity_id",
        "created_at_ms",
        "attempt",
        "status"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "watchlist",
            "title_watched",
            "episode_watched",
            "season_watched",
            "rating"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "entity_id": {
          "type": "string",
          "minLength": 1
        },
        "created_at_ms": {
          "type": "integer",
          "minimum": 0
        },
        "attempt": {
          "type": "integer",
          "minimum": 0
        },
        "next_attempt_ms": {
          "type": "integer",
          "minimum": 0
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "inflight",
            "failed",
            "conflict"
          ]
        },
        "status_reason": {
          "type": "string"
        },
        "status_server_value": {
          "type": [
            "string",
            "null"
          ]
        },
        "desired": {
          "type": [
            "boolean",
            "integer",
            "null"
          ]
        },
        "season": {
          "type": "integer"
        },
        "episode": {
          "type": [
            "integer",
            "null"
          ]
        },
        "video_id": {
          "type": "string"
        },
        "season_number": {
          "type": "integer"
        },
        "season_item_id": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "derived_field_bool": {
      "type": "object",
      "required": [
        "value",
        "sync"
      ],
      "properties": {
        "value": {
          "type": "boolean"
        },
        "sync": {
          "type": "string",
          "enum": [
            "idle",
            "syncing",
            "error"
          ]
        }
      },
      "additionalProperties": false
    },
    "derived_field_rating": {
      "type": "object",
      "required": [
        "value",
        "sync"
      ],
      "properties": {
        "value": {
          "type": [
            "integer",
            "null"
          ]
        },
        "sync": {
          "type": "string",
          "enum": [
            "idle",
            "syncing",
            "error"
          ]
        }
      },
      "additionalProperties": false
    }
  }
}

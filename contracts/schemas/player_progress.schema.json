{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "player_progress fixture",
  "type": "object",
  "required": [
    "contract_version",
    "suite",
    "case_id",
    "input",
    "expected"
  ],
  "properties": {
    "contract_version": {
      "type": "integer",
      "minimum": 1
    },
    "suite": {
      "const": "player_progress"
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "input": {
      "type": "object",
      "required": [
        "position_ms",
        "duration_ms"
      ],
      "properties": {
        "position_ms": {
          "type": "integer"
        },
        "duration_ms": {
          "type": "integer"
        }
      },
      "additionalProperties": false
    },
    "expected": {
      "type": "object",
      "required": [
        "store_or_drop",
        "is_completed"
      ],
      "properties": {
        "store_or_drop": {
          "type": "string",
          "enum": ["store", "drop"]
        },
        "is_completed": {
          "type": "boolean"
        },
        "stored_position_ms": {
          "type": "integer"
        },
        "event_position_ms": {
          "type": "integer"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
